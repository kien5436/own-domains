{
  "name": "own-domains",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "setup": "tsx src/cli/setup.ts",
    "test:e2e": "playwright test",
    "test:native-daemon": "cargo test --workspace",
    "uninstall": "tsx src/cli/uninstall.ts",
    "typecheck": "tsc -b --pretty false",
    "verify:native-core": "cargo test -p own-domains-core && pnpm test && pnpm run lint && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-pk": "^2.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
